# Copie para .env (cp .env.example .env). O .env não é versionado.

# Obrigatório. O usuário, a senha e a porta batem com o docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/project_manager?sslmode=disable

# Opcionais (valores padrão abaixo)
# PORT=8080
# Pasta onde ficam as capas enviadas (POST /uploads)
# UPLOAD_DIR=uploads
