{
  "name": "project-manager-clicksign",
  "version": "0.0.1",
  "private": true,
  "description": "A Quasar Project",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "Ana Morais <analopesdemorais@outlook.com>",
  "type": "module",
  "scripts": {
    "lint": "oxfmt && stylelint \"src/**/*.{vue,scss}\" --fix && oxlint --fix",
    "lint:check": "oxfmt --check && stylelint \"src/**/*.{vue,scss}\" && oxlint",
    "dev": "quasar dev",
    "build": "quasar build",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare --silent",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "axios": "^1.21.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^22.19.11",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.27",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.8",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^6.0.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  },
  "productName": "Project Manager"
}
